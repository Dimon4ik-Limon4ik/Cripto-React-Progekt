# Шаблон секретов. Скопируйте файл в secrets/.env и заполните значения.
# secrets/.env исключён из Git и никогда не должен попадать в репозиторий.

# Секрет для подписи JWT — любая длинная случайная строка
SECRET_KEY=replace-with-a-long-random-secret

# Доступ к PostgreSQL
UserBD=postgres
passwordBD=your_db_password

# Ключ CoinGecko Demo API (используется только на сервере)
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxx

# Необязательные параметры сервера (можно не указывать)
# PORT=3000
# CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
